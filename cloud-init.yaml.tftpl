#cloud-config
package_update: false
runcmd:
  - [ bash, -lc, "export RADAR_WP_ADMIN_PASS='${wp_admin_password}'; curl -fsSL https://raw.githubusercontent.com/jokas29/radar-dropi-ecuador/commerce-bridge/oracle/install-commerce.sh | bash >/var/log/radar-commerce-install.log 2>&1" ]
final_message: "Radar Commerce bootstrap launched."
